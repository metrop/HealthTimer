<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <Settings>
    <Setting Name="EnableHealthTimer" Type="bool" Value="true" ShowInMenus="true" />
    
    <Setting Name="CheckCooldown" Type="float" Value="1.0" ShowInMenus="true" />

    <Setting Name="MaxPredict" Type="int" Value="300" Min="60" Max="3000" ShowInMenus="true" />
    
    <Setting Name="Mode" Type="listString" Value="Normal" ShowInMenus="true">
      <Values>
        <Value Value="Minimal" />
        <Value Value="Normal" />
      </Values>
    </Setting>
  </Settings>

  <Profiles>
    <Profile Name="default">
      <SettingValue Name="EnableHealthTimer" Value="true" />
      <SettingValue Name="CheckCooldown" Value="1.0" />
      <SettingValue Name="Mode" Value="Normal" />
      <SettingValue Name="MaxPredict" Value="300" />
    </Profile>
  </Profiles>
</Configuration>